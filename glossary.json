{
  "about": "Every term the lessons teach, in the order they teach them. tests/unit/terms.test.js checks the lessons against this file. See docs/PEDAGOGY.md.",
  "terms": [
    { "term": "metronome", "aliases": [], "lesson": 1, "kind": "music",
      "define": "a click that keeps steady time",
      "more": "https://en.wikipedia.org/wiki/Metronome" },
    { "term": "beat", "aliases": [], "lesson": 1, "kind": "music",
      "define": "the steady pulse you tap your foot to",
      "more": "https://en.wikipedia.org/wiki/Beat_(music)" },
    { "term": "bar", "aliases": ["measure"], "lesson": 1, "kind": "music",
      "define": "a group of beats; most pop and dance music has four beats in a bar",
      "more": "https://en.wikipedia.org/wiki/Bar_(music)" },
    { "term": "sixteenth note", "aliases": ["sixteenth", "sixteenths"], "lesson": 1, "kind": "music",
      "define": "a quarter of a beat, so a bar of four beats holds sixteen of them",
      "more": "https://en.wikipedia.org/wiki/Sixteenth_note" },
    { "term": "step", "aliases": [], "lesson": 1, "kind": "music",
      "define": "one slot in a sequencer's row; here, one sixteenth note",
      "more": "https://en.wikipedia.org/wiki/Music_sequencer" },
    { "term": "loop", "aliases": [], "lesson": 1, "kind": "music",
      "define": "a section that plays again from the start each time it ends",
      "more": "https://en.wikipedia.org/wiki/Loop_(music)" },
    { "term": "memory", "aliases": [], "lesson": 1, "kind": "computer",
      "define": "a long row of boxes, each holding one small number",
      "more": "https://en.wikipedia.org/wiki/Computer_memory" },
    { "term": "address", "aliases": [], "lesson": 1, "kind": "computer",
      "define": "a box's number in the row",
      "more": "https://en.wikipedia.org/wiki/Memory_address" },
    { "term": "byte", "aliases": [], "lesson": 1, "kind": "computer",
      "define": "what one box holds: a whole number from 0 to 255",
      "more": "https://en.wikipedia.org/wiki/Byte" },
    { "term": "hex", "aliases": [], "lesson": 1, "kind": "computer",
      "define": "a way of writing numbers that counts in sixteens, using A to F for ten to fifteen",
      "more": "https://en.wikipedia.org/wiki/Hexadecimal" },
    { "term": "voice", "aliases": [], "lesson": 1, "kind": "music",
      "define": "one sound the chip can play at the same time as the others",
      "more": "https://en.wikipedia.org/wiki/Polyphony_and_monophony_in_instruments" },
    { "term": "kick drum", "aliases": ["kick"], "lesson": 1, "kind": "music",
      "define": "the low boom at the bottom of most dance music",
      "more": "https://en.wikipedia.org/wiki/Bass_drum" },
    { "term": "four on the floor", "aliases": [], "lesson": 1, "kind": "music",
      "define": "a kick drum on every beat",
      "more": "https://en.wikipedia.org/wiki/Four_on_the_floor_(music)" },
    { "term": "POKE", "aliases": [], "lesson": 1, "kind": "computer",
      "define": "put a value into the box at an address",
      "more": "https://en.wikipedia.org/wiki/PEEK_and_POKE" },
    { "term": "PEEK", "aliases": [], "lesson": 1, "kind": "computer",
      "define": "read the value in the box at an address",
      "more": "https://en.wikipedia.org/wiki/PEEK_and_POKE" },
    { "term": "snare drum", "aliases": ["snare"], "lesson": 1, "kind": "music",
      "define": "the sharp crack that answers the kick",
      "more": "https://en.wikipedia.org/wiki/Snare_drum" },
    { "term": "backbeat", "aliases": [], "lesson": 1, "kind": "music",
      "define": "the snare on beats 2 and 4",
      "more": "https://en.wikipedia.org/wiki/Beat_(music)#Backbeat" },
    { "term": "memory-mapped", "aliases": [], "lesson": 1, "kind": "computer",
      "define": "a device you control by writing ordinary memory addresses",
      "more": "https://en.wikipedia.org/wiki/Memory-mapped_I/O_and_port-mapped_I/O" }
  ]
}
